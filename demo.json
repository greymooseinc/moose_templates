{
    "id": "demo",
    "description": "Demo app with almost all the features",
    "version": "1.0.0",
    "base": {
        "repository": "https://github.com/greymooseinc/moose_starter.git",
        "ref": "main"
    },
    "extensions": {
        "repository": "https://github.com/greymooseinc/moose_extensions.git",
        "ref": "main"
    },
    "plugins": [
        {
            "name": "home",
            "version": "1.0.0",
            "configurations": {
                "active": true,
                "sections": {
                    "main": [
                        {
                            "name": "banner_section",
                            "description": "Swipeable promotional banners",
                            "settings": {
                            "key": "home_banner",
                            "height": 300,
                            "autoPlayInterval": 5,
                            "showIndicators": true,
                            "placement": "home",
                            "locale": "en"
                            }
                        },
                        {
                            "name": "shorts.gallery",
                            "active": true,
                            "description": "Instagram/Facebook Stories-style shorts gallery",
                            "settings": {
                            "key": "home_shorts",
                            "perPage": 10,
                            "showTitle": true
                            }
                        },
                        {
                            "name": "product.products_section",
                            "description": "New arrivals carousel",
                            "settings": {
                            "title": "NEW ARRIVALS",
                            "sectionHeight": 120,
                            "cardWidth": 100,
                            "cardSpacing": 12,
                            "horizontalPadding": 20,
                            "titleSpacing": 20,
                            "loadingItemCount": 8,
                            "showBadge": true,
                            "badgeText": "NEW",
                            "productDetailRoute": "/product",
                            "emptyMessage": "No new arrivals available",
                            "errorMessage": "Failed to load new arrivals",
                            "filters": {
                                "page": 1,
                                "perPage": 2,
                                "sortBy": "date",
                                "sortOrder": "desc",
                                "featured": true
                            }
                            }
                        },
                        {
                            "name": "product.products_section",
                            "description": "Featured products carousel",
                            "settings": {}
                        },
                        {
                            "name": "recently_viewed.section",
                            "description": "Recently viewed products carousel",
                            "settings": {
                            "title": "RECENTLY VIEWED",
                            "maxAge": 72,
                            "cacheTTL": 24,
                            "limit": 10,
                            "showViewAll": true,
                            "viewAllRoute": "/recently-viewed"
                            }
                        }
                    ],
                    "appBarButtonsLeft": [
                        {
                            "name": "search.app_bar_button",
                            "description": "Search app bar button",
                            "settings": {}
                        }
                        ],
                        "appBarButtonsRight": [
                        {
                            "name": "settings.app_bar_button",
                            "description": "Settings navigation button",
                            "settings": {}
                        },
                        {
                            "name": "theme.app_bar_button",
                            "description": "Light/dark theme toggle",
                            "settings": {}
                        },
                        {
                            "name": "cart.app_bar_button",
                            "description": "Cart app bar button",
                            "settings": {}
                        }
                    ]
                }
            }
        },
        {
            "name": "shorts",
            "version": "1.0.0"
        },
        {
            "name": "banner",
            "version": "1.0.0"
        },
        {
            "name": "core_ui",
            "version": "1.0.0"
        },
        {
            "name": "settings",
            "version": "1.0.0",
            "configurations": {
                "active": true,
                "sections": {
                    "items": [
                    {
                        "name": "settings.section_header",
                        "description": "Appearance section heading",
                        "settings": {
                        "title": "Appearance"
                        }
                    },
                    {
                        "name": "theme.settings_item",
                        "description": "Light / Dark / System theme selector",
                        "settings": {}
                    }
                    ]
                }
            }
        },
        {
            "name": "theme_manager",
            "version": "1.0.0"
        },
        {
            "name": "theme_default",
            "version": "1.0.0"
        },
        {
            "name": "share",
            "version": "1.0.0"
        },
        {
            "name": "search",
            "version": "1.0.0"
        },
        {
            "name": "products",
            "version": "1.0.0",
            "configurations": {
                "sections": {
                    "main": [
                    ],
                    "appBarButtonsLeft": [
                    {
                        "name": "search.app_bar_button",
                        "description": "Search app bar button",
                        "settings": {}
                    }
                    ],
                    "appBarButtonsRight": [
                    {
                        "name": "settings.app_bar_button",
                        "description": "Settings navigation button",
                        "settings": {}
                    },
                    {
                        "name": "theme.app_bar_button",
                        "description": "Light/dark theme toggle",
                        "settings": {}
                    },
                    {
                        "name": "cart.app_bar_button",
                        "description": "Cart app bar button",
                        "settings": {}
                    }
                    ]
                },
                "settings": {
                    "cache": {
                    "categoriesTTL": 600,
                    "productsTTL": 300,
                    "productDetailTTL": 300,
                    "collectionsTTL": 600,
                    "tagsTTL": 600,
                    "brandsTTL": 600
                    },
                    "filters": {
                    "default_product_list": {
                        "page": 1,
                        "perPage": 10
                    }
                    }
                }
                }
        },
        {
            "name": "cart",
            "version": "1.0.0"
        }
    ],
    "adapters": [
        {
            "name": "demo",
            "version": "1.0.0",
            "configurations": {
                "bannerApiUrl": "https://greymooseinc.github.io/moose_static/banners_001.json",
                "shortsApiUrl": "https://greymooseinc.github.io/moose_static/short_001.json"
            }
        }
    ]
}